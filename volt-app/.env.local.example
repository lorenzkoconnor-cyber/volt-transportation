# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # Server-side only — never expose

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Found in: Stripe Dashboard → Developers → API Keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_SECRET_KEY=sk_test_your-secret-key              # Server-side only
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret        # From: stripe listen --forward-to

# ─── Square (walk-in tap-to-pay on the counter Square Terminal) ──────────────
# developer.squareup.com → your app → Credentials (use the Sandbox tab to test).
# Leave blank to run the Terminal in simulated mode.
SQUARE_ENVIRONMENT=sandbox                              # sandbox | production
SQUARE_ACCESS_TOKEN=                                    # Server-side only
SQUARE_LOCATION_ID=
# Webhooks → Subscriptions → https://volt-transportation.com/api/payments/square-webhook
# Events: terminal.checkout.updated, refund.updated
SQUARE_WEBHOOK_SIGNATURE_KEY=
# SQUARE_WEBHOOK_URL=                                   # only if it differs from NEXT_PUBLIC_APP_URL + /api/payments/square-webhook

# ─── RingCentral (SMS — confirmations, receipts, reminders) ─────────────────
# developers.ringcentral.com → your app → Credentials. JWT = the user who owns
# the Volt number. Replies go to that number's inbox in the RingCentral app.
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_JWT=
RINGCENTRAL_FROM_NUMBER=+1xxxxxxxxxx

# ─── Email (Hostinger mailbox over SMTP — no other provider) ─────────────────
# hPanel → Emails → contactvolt.com → the support@ mailbox →
# Configure devices shows these. Confirmations, receipts, staff alerts and
# Contact-page messages are sent from it.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@contactvolt.com
SMTP_PASS=
EMAIL_FROM="Volt Transportation <support@contactvolt.com>"
SUPPORT_EMAIL=support@contactvolt.com          # where Contact-page messages go

# ─── Reminder cron ───────────────────────────────────────────────────────────
# Shared secret Supabase pg_cron sends to /api/cron/reminders (≥16 chars).
# That 10-minute job also retries failed texts/emails and runs the staff alerts.
# Must match the Supabase Vault secret named "cron_secret".
CRON_SECRET=

# ─── Twilio (SMS, legacy fallback — RingCentral is used when configured) ────
# Found in: Twilio Console → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx                       # Your Twilio phone number

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000              # Production: https://volt-transportation.com
